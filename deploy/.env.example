APP_ORIGIN=https://intelligrid.example.org
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-public-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-worker-only-key
OPENAI_API_KEY=replace-with-worker-only-key
OPENAI_MODEL=gpt-5.4-mini-2026-03-17
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe-2025-12-15
# openai | gemini | anthropic | openrouter | fixture (recorded demo readings, no key)
EXTRACTION_PROVIDER=openai
# For another provider, select it above and fill its key/model. Leave unused keys empty.
GEMINI_API_KEY=
GEMINI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# Empty = same provider for OpenAI/Gemini; disabled for Anthropic/OpenRouter.
TRANSCRIPTION_PROVIDER=
GEMINI_TRANSCRIPTION_MODEL=
# Exit after this many consecutive loop failures so the container restart policy can recover.
WORKER_MAX_CONSECUTIVE_FAILURES=12
