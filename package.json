{
  "name": "intelligrid",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@intelligrid/web",
    "build": "npm run build --workspace=@intelligrid/web",
    "start": "npm run start --workspace=@intelligrid/web",
    "typecheck": "tsc --noEmit && npm run typecheck --workspace=@intelligrid/web",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:fixtures": "tsx fixtures/check.ts",
    "worker:check": "npm run check --workspace=@intelligrid/worker",
    "check": "npm run typecheck && npm test && npm run check:fixtures && npm run worker:check",
    "test:browser": "node tests/browser/smoke.mjs",
    "seed:local": "tsx scripts/seed-local.ts",
    "test:database": "node scripts/test-database.mjs",
    "test:seed": "node scripts/test-seed-idempotency.mjs",
    "admin:member": "node scripts/admin-member.mjs",
    "local:bind": "node scripts/bind-local-docker.mjs",
    "db:reset:local": "supabase db reset --local --network-id intelligrid-local --yes",
    "worker:start": "tsx scripts/run-local-worker.ts",
    "test:reconciliation-db": "tsx scripts/test-reconciliation-db.ts",
    "test:live": "tsx scripts/verify-live-flow.ts",
    "test:browser:live": "tsx tests/browser/reconciliation.ts",
    "seed:clarification": "tsx scripts/seed-clarification-lab.ts",
    "test:clarification-db": "tsx scripts/test-clarification-db.ts",
    "test:browser:clarification": "tsx tests/browser/clarification.ts",
    "test:browser:clarification-review": "tsx tests/browser/clarification-review.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@supabase/supabase-js": "2.116.0",
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prettier": "3.9.8",
    "supabase": "2.117.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.1"
  }
}
