# Copy to apps/web/.env.local for a manually configured environment.
# npm run seed:local writes this file automatically for the local stack.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:56321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-anon-or-publishable-key
APP_ORIGIN=http://localhost:3000
# The web app never uses the service-role key. Keep it out of NEXT_PUBLIC_*.
