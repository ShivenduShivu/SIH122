# Worker configuration. All provider keys and the service-role key are server-only.
SUPABASE_URL=http://127.0.0.1:56321
SUPABASE_SERVICE_ROLE_KEY=replace-with-operator-service-role-key
OPENAI_API_KEY=replace-with-openai-key
OPENAI_MODEL=gpt-5.4-mini-2026-03-17
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe-2025-12-15
EXTRACTION_PROVIDER=openai
# Select gemini, anthropic (Claude), or openrouter and set that provider's key/model.
# EXTRACTION_PROVIDER=fixture replays recorded demo readings with no key and no network call.
# It answers only the reports in packages/adapters/fixtures/demo-extractions.json and labels
# every claim as scripted. See docs/demo-runbook.md.
# Model IDs must support structured JSON output. See docs/providers.md.
GEMINI_API_KEY=
GEMINI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# Empty = same provider for OpenAI/Gemini; disabled for Anthropic/OpenRouter.
# Set openai or gemini explicitly to enable voice alongside Claude/OpenRouter.
TRANSCRIPTION_PROVIDER=
GEMINI_TRANSCRIPTION_MODEL=
# Exit after this many consecutive loop failures so a supervisor can restart the worker.
WORKER_MAX_CONSECUTIVE_FAILURES=12
# Local shortcut: npm run worker:start loads Supabase credentials from ignored .cache/supabase.env.
# OPENAI_API_KEY can instead be provided in the process environment.
