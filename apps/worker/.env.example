# Production or standalone worker configuration. Keep all three values server-only.
SUPABASE_URL=http://127.0.0.1:56321
SUPABASE_SERVICE_ROLE_KEY=replace-with-operator-service-role-key
OPENAI_API_KEY=replace-with-openai-key
OPENAI_MODEL=gpt-5.4-mini-2026-03-17
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe-2025-12-15
# Local shortcut: npm run worker:start loads Supabase credentials from ignored .cache/supabase.env.
# OPENAI_API_KEY can instead be provided in the process environment.
